  "dialogues": {
    "captive_cleric_maiden": {
      "node_althea_rescue": {
        "text": "The sacrificial altar is broken... the dark ceremony has been thwarted! I am Sister Althea of the Church of Law. The priest was preparing to summon an abyssal fiend under the dark moon! You have preserved the entire realm from devastation!",
        "choices": [
          {
            "id": "choice_althea_bless",
            "text": "\"Kneel, Sister Althea. The evil priest is slain and Law reigns triumphant.\"",
            "onSuccess": "node_althea_triumph",
            "alignment_impact": {
              "order": 3,
              "morality": 3,
              "reason": "Cleansed the unholy shrine and delivered Sister Althea"
            }
          },
          {
            "id": "choice_althea_aid",
            "text": "[Cleric] \"The Light of Law shines through our fellowship. Let us escort you home.\"",
            "specialtyClass": "Cleric",
            "specialtyBonus": 3,
            "attribute": "wisdom",
            "onSuccess": "node_althea_triumph"
          }
        ]
      },
      "node_althea_triumph": {
        "text": "May the eternal heavens shower grace upon your fellowship. Take the sacred Vestment of Law and this pouch of blessed pearls. The Castellan will herald you as the saviors of the Borderlands!",
        "giveItem": "Holy Water",
        "giveGold": 300,
        "questXP": 2500,
        "choices": [
          {
            "text": "For Law and the Light!",
            "onSuccess": null
          }
        ]
      }
    }
