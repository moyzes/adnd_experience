  "dialogue": {
    "node_althea_rescue": {
      "speaker": "Lady Althea (Rescued Pilgrim)",
      "text": "The gods of Law have answered our prayers! They were going to sacrifice me on that black altar when the moon reached its zenith! The Evil Priest commands both living cultists and the walking dead from the crypts. Slay him and take the Eye of Chaos to the Castellan at the Keep — it will break the curse of these caves once and for all!",
      "alignment_impact": {
        "order": 2,
        "morality": 3,
        "reason": "Rescued innocent sacrificial victim from the altar of Chaos"
      },
      "options": [
        {
          "label": "We will cleanse this temple and take down the Priest!",
          "targetNode": "node_althea_vow"
        },
        {
          "label": "Stay behind us, Lady Althea. You are safe now.",
          "targetNode": null
        }
      ]
    },
    "node_althea_vow": {
      "speaker": "Lady Althea (Rescued Pilgrim)",
      "text": "May the light of the Sun Lord shield your hearts against his blasphemies!",
      "options": [
        {
          "label": "For Law and the Light!",
          "targetNode": null
        }
      ]
    }
  },
