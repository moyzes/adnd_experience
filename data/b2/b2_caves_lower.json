  "dialogues": {
    "rescued_guard": {
      "node_thomas_greet": {
        "text": "By the gods! You broke through the bugbear line! I am Thomas, a scout from the Keep garrison. Captain Bain sent my squad here a week ago, but we were overrun. The rest of my men were dragged down into the lower shrine...",
        "choices": [
          {
            "id": "choice_guard_free",
            "text": "\"Take this weapon, Thomas. Retreat to the surface while the path is clear.\"",
            "onSuccess": "node_thomas_free",
            "alignment_impact": {
              "order": 2,
              "morality": 2,
              "reason": "Rescued captured Keep garrison scout"
            }
          },
          {
            "id": "choice_guard_intel",
            "text": "\"Tell us about the lower shrine before you leave.\"",
            "onSuccess": "node_thomas_shrine_intel"
          }
        ]
      },
      "node_thomas_free": {
        "text": "Bless you all! I will make my way back to Captain Bain and report your heroism. Take my silver dagger — may it strike true against the darkness!",
        "giveItem": "Silver Dagger",
        "questXP": 500,
        "choices": [
          {
            "text": "Godspeed, Thomas.",
            "onSuccess": null
          }
        ]
      },
      "node_thomas_shrine_intel": {
        "text": "The shrine is guarded by fanatical cultists in red robes and armored skeletons. Their Evil Priest carries a bronze serpent rod that casts hold person and fear spells. Do not fight him in the open altar room without magical protection!",
        "choices": [
          {
            "text": "Thank you for the warning. Now get to safety.",
            "onSuccess": null
          }
        ]
      }
    }
  }
}