  "dialogue": {
    "node_thomas_greet": {
      "speaker": "Corporal Thomas (Keep Scout Prisoner)",
      "text": "By the grace of the Castellan! You broke through the bugbear slavers! I was captured while scouting the ravine three days ago. Listen closely: there is a secret passage at the back of this lower complex (south of the Minotaur's maze) that leads straight into Cave K — the Shrine of Chaos! The priest is preparing a massive unholy ritual!",
      "alignment_impact": {
        "order": 1,
        "morality": 2,
        "reason": "Liberated imprisoned Keep scouts from the bugbear slavers"
      },
      "options": [
        {
          "label": "We will storm the Shrine and put an end to this ritual!",
          "targetNode": "node_thomas_honor"
        },
        {
          "label": "Take this weapon and retreat to the Keep, soldier.",
          "targetNode": "node_thomas_retreat"
        }
      ]
    },
    "node_thomas_honor": {
      "speaker": "Corporal Thomas (Keep Scout Prisoner)",
      "text": "The Castellan chose well when he commissioned your company. May Law watch over your strike!",
      "options": [
        {
          "label": "For the Keep!",
          "targetNode": null
        }
      ]
    },
    "node_thomas_retreat": {
      "speaker": "Corporal Thomas (Keep Scout Prisoner)",
      "text": "Understood! I will rally the watchmen at the gate and tell the Castellan of your deeds!",
      "options": [
        {
          "label": "Go swiftly.",
          "targetNode": null
        }
      ]
    }
  },
