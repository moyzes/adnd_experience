  "dialogues": {
    "mad_hermit": {
      "node_hermit_greet": {
        "text": "Gaaah! Who stomps through my briars?! Keep-dwellers? Mercenaries? Fools with shiny steel looking to die in the ravine! The trees have eyes, I tell you, and the mountain swallows men whole!",
        "choices": [
          {
            "id": "choice_hermit_bribe",
            "text": "Calm yourself, old man. Take 5 gold and tell us about the ravines.",
            "cost": {
              "gold": 5
            },
            "onSuccess": "node_hermit_intel",
            "attitudeShift": 20
          },
          {
            "id": "choice_cleric_calm",
            "text": "[Cleric] \"Peace, traveler. The light protects this land. Tell us what terrors haunt the valley.\"",
            "specialtyClass": "Cleric",
            "specialtyBonus": 3,
            "attribute": "wisdom",
            "onSuccess": "node_hermit_secret",
            "attitudeShift": 30
          },
          {
            "text": "Leave the raving hermit alone.",
            "onSuccess": null
          }
        ]
      },
      "node_hermit_intel": {
        "text": "Hehehe! Shiny coins! Listen well: the lower cave mouths belong to the red-skinned goblins and yellow-eyed orcs. They hate each other! If you stir a brawl between them, they will kill each other and leave their treasure unguarded!",
        "choices": [
          {
            "text": "A cunning strategy. Thank you.",
            "onSuccess": null
          }
        ]
      },
      "node_hermit_secret": {
        "text": "Your holy words... the mist clears in my head for a moment. Beware the dark cloaks in the hidden shrine. They wear blood-red robes and chant forbidden names. Take this healing elixir — you will need it more than I.",
        "giveItem": "Healing Potion",
        "questXP": 100,
        "alignment_impact": {
          "order": 1,
          "morality": 1,
          "reason": "Calmed the mad hermit with divine compassion"
        },
        "choices": [
          {
            "text": "Thank you, friend. Go in peace.",
            "onSuccess": null
          }
        ]
      }
    }
  }
