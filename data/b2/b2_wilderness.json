  "dialogue": {
    "node_hermit_greet": {
      "speaker": "The Mad Hermit",
      "text": "Hee hee! Skitter, scatter, steel-clad fools! Tread softly on the roots of my woods! The spiders spin thick silk in the copse to the east, and the green-skins squabble in the ravine below. Did you bring dried meats for my cat, or do you come to disturb an old man's communion with the crows?",
      "options": [
        {
          "label": "Tell us of the Caves of Chaos down the ravine.",
          "targetNode": "node_hermit_caves"
        },
        {
          "label": "Have you seen any priests or strange cultists?",
          "targetNode": "node_hermit_cult"
        },
        {
          "label": "We leave you to your woods, old hermit.",
          "targetNode": null
        }
      ]
    },
    "node_hermit_caves": {
      "speaker": "The Mad Hermit",
      "text": "The ravine is shaped like a gaping jaw! The lower teeth are full of little yapping kobolds and squabbling orc tribes who hate each other's guts — a clever tongue could make them slit each other's throats! But higher up... oh yes, the big brutes dwell. A lumbering ogre who loves shiny gold, and iron-clad hobgoblins who march like toy soldiers!",
      "options": [
        {
          "label": "What lies in the deep cleft at the ravine's head?",
          "targetNode": "node_hermit_cult"
        },
        {
          "label": "Thank you for the counsel.",
          "targetNode": null
        }
      ]
    },
    "node_hermit_cult": {
      "speaker": "The Mad Hermit",
      "text": "Hush! Speak not of the Black Altar! Under the dark of the moon, hooded figures in blood-red vestments sneak into the deepest cavern. The dead walk in the crypts beside them! If you go there, bring steel and righteous prayers, or your bones will hang on their iron racks!",
      "options": [
        {
          "label": "We shall cleanse that darkness.",
          "targetNode": null
        }
      ]
    }
  },
