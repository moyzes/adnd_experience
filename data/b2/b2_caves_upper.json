  "dialogues": {
    "merchant_captive": {
      "node_captive_greet": {
        "text": "Merciful gods, you killed the guards! Please, untie my bonds before the rest of the warband returns! I am Master Corvin of the Merchant Guild. The goblins ambushed our caravan on the mountain pass two days ago.",
        "choices": [
          {
            "id": "choice_rescue_corvin",
            "text": "\"You are safe now, Corvin. Cut his ropes and escort him toward the exit.\"",
            "onSuccess": "node_captive_rescued",
            "alignment_impact": {
              "order": 1,
              "morality": 2,
              "reason": "Rescued captive merchant from goblin warrens"
            }
          },
          {
            "id": "choice_thief_bounty",
            "text": "[Thief] \"Rescues don't come free in goblin territory. What reward can the Merchant Guild offer?\"",
            "specialtyClass": "Thief",
            "specialtyBonus": 2,
            "attribute": "charisma",
            "onSuccess": "node_captive_reward"
          }
        ]
      },
      "node_captive_rescued": {
        "text": "Thank you, brave heroes! I shall sprint for the sunlight immediately. When you return to the Keep, tell the Provisioner that Corvin lives — he will reward you handsomely with fine gear!",
        "giveGold": 75,
        "questXP": 400,
        "choices": [
          {
            "text": "Run swiftly, Corvin!",
            "onSuccess": null
          }
        ]
      },
      "node_captive_reward": {
        "text": "I have a hidden stash of 120 gold pieces back at the Keep's counting house, and a pouch of uncut gems right in my boot lining! Take the gems now, and collect the rest at the bailey!",
        "giveItem": "Ancient Rubies",
        "giveGold": 60,
        "questXP": 300,
        "choices": [
          {
            "text": "Pleasure doing business. Head for the exit.",
            "onSuccess": null
          }
        ]
      }
    },
    "orc_t2_emissary": {
      "node_orc2_parley": {
        "text": "Hold your steel, surface dogs! Chief Grash of Clan Bloodskull does not want your blood today. The filthy Tree-Biter Goblins in the eastern tunnels stole our sacred war horn. If you slaughter their chieftains, we will grant you safe passage through our lower hall!",
        "choices": [
          {
            "id": "choice_orc_parley_accept",
            "text": "\"A temporary truce. We will eliminate the goblin leaders.\"",
            "onSuccess": "node_orc_truce",
            "attitudeShift": 15
          },
          {
            "id": "choice_orc_parley_refuse",
            "text": "\"We make no pacts with ravenous orcs. Draw your blade!\"",
            "onSuccess": null
          }
        ]
      },
      "node_orc_truce": {
