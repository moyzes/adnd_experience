  "dialogue": {
    "node_captive_greet": {
      "speaker": "Gerrard the Merchant (Captive)",
      "text": "Praised be the gods! You broke through the orc guard! I am Gerrard, a wine merchant from the southern road. The orcs ambushed our caravan three days ago. They slaughtered my guards and dragged me here. Please, tell me the path to the Keep is clear!",
      "alignment_impact": {
        "order": 1,
        "morality": 2,
        "reason": "Rescued captured merchant from the orc chieftain"
      },
      "options": [
        {
          "label": "The way behind us is cleared. Flee to the Keep, friend!",
          "targetNode": "node_captive_safe"
        },
        {
          "label": "Did you hear anything about an evil shrine nearby?",
          "targetNode": "node_captive_intel"
        }
      ]
    },
    "node_captive_safe": {
      "speaker": "Gerrard the Merchant (Captive)",
      "text": "Thank you, noble heroes! Take this pouch of 50 gold pieces I had sewn inside my boot lining. May fortune favor your blades!",
      "options": [
        {
          "label": "Go safely, Gerrard.",
          "targetNode": null
        }
      ]
    },
    "node_captive_intel": {
      "speaker": "Gerrard the Merchant (Captive)",
      "text": "Yes! The orcs spoke of 'The Masters in Red' who dwell in the great chasm at the ravine's head. They bring tribute to the shrine every full moon to receive dark blessings. The shrine is heavily guarded by priests and undead!",
      "options": [
        {
          "label": "Flee to the Keep now. We will handle the cult.",
          "targetNode": null
        }
      ]
    },
    "node_orc2_parley": {
      "speaker": "Gorbad (Orc Tribe 2 Sentry)",
      "text": "Grrr! Halt, pink-skins! You kill Tribe 1 chieftain in north cave? Good! Tribe 1 are filthy dogs! We of Tribe 2 rule the south tunnels. If you not attack our chieftain Grash, we not skewer you... for now!",
      "options": [
        {
          "label": "We have no quarrel with Tribe 2 if you stay out of our way.",
          "targetNode": "node_orc2_truce"
        },
        {
          "label": "All monsters in these caves must fall! Draw steel!",
          "targetNode": null
        }
      ]
    },
    "node_orc2_truce": {
      "speaker": "Gorbad (Orc Tribe 2 Sentry)",
      "text": "Ha! Smart humans. Beware the big ugly Ogre in the middle cavern. He eats orcs and humans alike!",
      "alignment_impact": {
        "order": 0,
        "morality": 0,
        "reason": "Negotiated uneasy truce with rival orc clan"
      },
      "options": [
        {
          "label": "We will take note.",
          "targetNode": null
        }
      ]
    }
  },
