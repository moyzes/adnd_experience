  "dialogues": {
    "mira_vale": {
      "node_mira_found": {
        "text": "Mira Vale presses herself against the damp wall, wrists raw from rope. 'You are from the village… or did Harlan Marrow send you to finish what his family started? I found the truth. The bones are a lie. The Marrows used Saint Orlan’s name to seize our land. My uncle Corvin only wanted the village to see it.'",
        "choices": [
          {
            "id": "choice_mira_comfort",
            "text": "Tend her wounds and swear to bring her out alive.",
            "attribute": "wisdom",
            "dc": 10,
            "specialtyClass": "Cleric",
            "specialtyBonus": 4,
            "moral_tax": 12,
            "clericMultiplier": 1.5,
            "attitudeShift": 30,
            "onSuccess": "node_mira_trusts",
            "onFail": "node_mira_wary"
          },
          {
            "id": "choice_mira_demand",
            "text": "Demand the location of the bones and her uncle — no softness.",
            "attribute": "strength",
            "dc": 11,
            "specialtyClass": "Fighter",
            "specialtyBonus": 3,
            "moral_tax": -10,
            "clericMultiplier": 2.0,
            "attitudeShift": -15,
            "onSuccess": "node_mira_points",
            "onFail": "node_mira_silent"
          },
          {
            "id": "choice_mira_listen",
            "text": "Stay quiet and let her talk. Watch for the truth between the words.",
            "attribute": "intelligence",
            "dc": 11,
            "specialtyClass": "Mage",
            "specialtyBonus": 3,
            "moral_tax": 0,
            "attitudeShift": 10,
            "onSuccess": "node_mira_truth",
            "onFail": "node_mira_wary"
          },
          {
            "id": "choice_mira_sneak_info",
            "text": "Offer a quiet escape route if she hands over any key or map she took.",
            "attribute": "dexterity",
            "dc": 10,
            "specialtyClass": "Thief",
            "specialtyBonus": 4,
            "moral_tax": -5,
            "attitudeShift": 5,
            "onSuccess": "node_mira_bargain",
            "onFail": "node_mira_wary"
          }
        ]
      },
      "node_mira_trusts": {
        "text": "She nods, tears cutting clean tracks through the grime. 'Corvin is in the northern reliquary. He has the femur. He will listen to a priest… maybe. The Marrows will call you heretics if you side with us.'",
        "choices": [
          {
            "id": "choice_leave",
            "text": "Leave her to rest and press deeper.",
            "onSuccess": null,
            "onEnd": "stay_silent"
          }
        ]
      },
      "node_mira_points": {
        "text": "She flinches but points north. 'Past the sealed door. He waits with the bone. Do what you will.'",
        "choices": [
          {
            "id": "choice_leave",
            "text": "Move on.",
            "onSuccess": null,
            "onEnd": "stay_silent"
          }
        ]
      },
      "node_mira_truth": {
        "text": "Between sobs she reveals more: the original interment records were altered. Saint Orlan’s true resting place was never this crypt. The bones are a prop in a land dispute that has poisoned Thorn for three generations.",
        "choices": [
          {
            "id": "choice_leave",
            "text": "File the knowledge away and continue.",
            "onSuccess": null,
            "onEnd": "stay_silent"
          }
        ]
      },
      "node_mira_bargain": {
        "text": "She presses a small iron key into your palm. 'Side door to the sanctum. My uncle does not know I took it. Get me out after.'",
        "choices": [
          {
            "id": "choice_leave",
            "text": "Pocket the key and go.",
            "onSuccess": null,
            "onEnd": "stay_silent"
          }
        ]
      },
      "node_mira_wary": {
        "text": "She draws her knees up and says nothing more. The feud has taught her that every kindness has a price.",
        "choices": [
          {
            "id": "choice_leave",
            "text": "Leave her.",
            "onSuccess": null,
            "onEnd": "stay_silent"
          }
        ]
      },
      "node_mira_silent": {
        "text": "She turns her face to the wall. You will get nothing further from Mira Vale.",
        "choices": [
          {
            "id": "choice_leave",
            "text": "Walk away.",
            "onSuccess": null,
            "onEnd": "stay_silent"
          }
        ]
      }
    },
    "corvin_vale": {
      "node_corvin_greeting": {
        "text": "An older man in frayed scholar’s robes stands before a stone plinth. A yellowed femur rests on dark cloth. 'So Marrow’s hired blades finally arrive. I am Corvin Vale. These bones are a fraud that kept my family landless and despised. I will not let the lie stand. Walk away, or become part of the story.'",
        "choices": [
          {
            "id": "choice_corvin_preach",
            "text": "Call upon the true light — demand he surrender the relic and face judgment.",
            "attribute": "wisdom",
            "dc": 13,
            "specialtyClass": "Cleric",
            "specialtyBonus": 4,
            "moral_tax": 20,
            "clericMultiplier": 2.0,
            "attitudeShift": 25,
            "onSuccess": "node_corvin_yields_faith",
            "onFail": "node_corvin_defiant"
          },
          {
            "id": "choice_corvin_threaten",
            "text": "Draw steel. The contract is clear: the bones return to Thorn.",
            "attribute": "strength",
            "dc": 12,
            "specialtyClass": "Fighter",
            "specialtyBonus": 4,
            "moral_tax": -8,
            "clericMultiplier": 1.8,
            "attitudeShift": -30,
            "onSuccess": "node_corvin_cowed",
            "onFail": "node_corvin_fights"
          },
          {
            "id": "choice_corvin_reason",
            "text": "Argue the evidence. A public accounting serves truth better than a crypt war.",
            "attribute": "intelligence",
            "dc": 12,
            "specialtyClass": "Mage",
            "specialtyBonus": 4,
            "moral_tax": 5,
            "attitudeShift": 15,
            "onSuccess": "node_corvin_considers",
            "onFail": "node_corvin_defiant"
          },
          {
            "id": "choice_corvin_deal",
            "text": "Offer a quiet deal: the bones leave with you, Mira lives, the feud stays buried for now.",
            "attribute": "charisma",
            "dc": 11,
            "specialtyClass": "Thief",
            "specialtyBonus": 3,
            "moral_tax": -12,
            "clericMultiplier": 2.2,
            "attitudeShift": 10,
            "onSuccess": "node_corvin_deal",
            "onFail": "node_corvin_defiant"
          }
        ]
      },
      "node_corvin_yields_faith": {
        "text": "Corvin’s shoulders sag. He places the femur in your hands. 'Take it. Let your god weigh the Marrows. I am finished with blood.' Mira can be freed. The crypt falls quiet.",
        "choices": [
          {
            "id": "choice_end",
            "text": "Accept the relic and end the confrontation.",
            "questXP": 2500,
            "onSuccess": null,
            "onEnd": "despawn"
          }
        ]
      },
      "node_corvin_cowed": {
        "text": "He steps back from the plinth, hands raised. 'Take the cursed bone. Tell Marrow the Vales are broken. Just leave my niece alive.'",
        "choices": [
          {
            "id": "choice_end",
            "text": "Claim the relic.",
            "questXP": 2500,
            "onSuccess": null,
            "onEnd": "despawn"
          }
        ]
      },
      "node_corvin_considers": {
        "text": "He listens, then nods once. 'A public reading of the true interment rolls… that could end it without more graves. Take the femur as surety. I will walk out with you under truce.'",
        "choices": [
          {
            "id": "choice_end",
            "text": "Accept the truce.",
            "questXP": 2500,
            "onSuccess": null,
            "onEnd": "despawn"
          }
        ]
      },
      "node_corvin_deal": {
        "text": "A thin smile. 'Pragmatic. The bone is yours. Mira walks free. The village never learns what we both know. Dirty hands all around — but fewer corpses.'",
        "choices": [
          {
            "id": "choice_end",
            "text": "Seal the quiet bargain.",
            "questXP": 2000,
            "onSuccess": null,
            "onEnd": "despawn"
          }
        ]
      },
      "node_corvin_defiant": {
        "text": "Corvin’s face hardens. He raises a hand and the cult guard steps forward. 'Then the crypt keeps its secrets in blood.'",
        "choices": [
          {
            "id": "choice_fight",
            "text": "Steel and spell.",
            "onSuccess": null,
            "onEnd": "despawn"
          }
        ]
      },
      "node_corvin_fights": {
        "text": "He laughs once — bitter, short — and the confrontation turns to violence.",
        "choices": [
          {
            "id": "choice_fight",
            "text": "Fight.",
            "onSuccess": null,
            "onEnd": "despawn"
          }
        ]
      }
    }
  },
  "epilogue_notes": {
    "success_bones_returned": "You climb back into the grey light of Thorn with Saint Orlan’s femur wrapped in oilcloth. Elder Marrow pays the promised coin and speaks of piety. Mira’s eyes, if she lives, say otherwise. The feud is not ended — only postponed. The crypt still floods when it rains.",
    "success_truth_exposed": "The true rolls are read in the village square. Some call it justice. Some call it heresy. Divine favor remembers which side the Cleric chose when the bone was still warm from Corvin’s hands.",
    "party_wiped": "The flooded dark keeps what it takes. In Thorn they light candles for the hired strangers and return to their old hatreds."
  }
}
