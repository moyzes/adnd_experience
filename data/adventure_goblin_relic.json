  "dialogues": {
    "lord_albright": {
      "node_patron_initial": {
        "text": "Greetings, brave sell-swords. I am Lord Raymond Albright, protector of Oakhaven. Under the cover of new moon, goblin savages descended from the northern crags, sacked our solar shrine, and stole our holy relic: The Sun-Forged Relic of Dawn. Without its blessing, our crops will wither and dark beasts will overrun the woods. I offer 250 Gold Pieces and the everlasting gratitude of Oakhaven if you venture through the wilderness into their ruined redoubt and recover the relic!",
        "choices": [
          {
            "id": "choice_accept_quest",
            "text": "\"We accept your contract, Lord Albright. The relic will be returned.\"",
            "onSuccess": "node_patron_instructions",
            "attitudeShift": 15
          },
          {
            "id": "choice_fighter_bounty",
            "text": "[Fighter] \"We are seasoned veterans. Tell us of their defenses and warlord.\"",
            "specialtyClass": "Fighter",
            "specialtyBonus": 3,
            "attribute": "strength",
            "onSuccess": "node_patron_tactical_intel",
            "onFail": "node_patron_instructions",
            "attitudeShift": 10
          },
          {
            "id": "choice_cleric_faith",
            "text": "[Cleric] \"Desecration of a solar shrine will not go unpunished. The light guides us.\"",
            "specialtyClass": "Cleric",
            "specialtyBonus": 3,
            "attribute": "wisdom",
            "onSuccess": "node_patron_blessing",
            "onFail": "node_patron_instructions",
            "attitudeShift": 25
          },
          {
            "id": "choice_thief_supplies",
            "text": "[Thief] \"A dangerous wilderness trek. Any advance provisions for the road?\"",
            "specialtyClass": "Thief",
            "specialtyBonus": 2,
            "attribute": "dexterity",
            "onSuccess": "node_patron_supplies",
            "onFail": "node_patron_instructions",
            "attitudeShift": 5
          }
        ]
      },
      "node_patron_instructions": {
        "text": "Before you march through the northern palisade into the wilderness, visit our Outfitter stall across the square. Stock up on torches, iron spikes, arrows, and healing draughts. Follow the trail through the dense pine wilderness until you reach the ancient stone ruins. Beware their chieftain, Grak'tar!",
        "choices": [
          {
            "id": "choice_parting",
            "text": "\"We shall prepare and set off immediately.\"",
            "onEnd": "stay_silent"
          }
        ]
      },
      "node_patron_tactical_intel": {
        "text": "Splendid! Their chieftain is Grak'tar, a scarred brute wielding a heavy spiked cleaver. The goblins have set spike snares in the outer halls and reanimated old bones with their dark shamanism. Take these healing salves to aid your steel!",
        "choices": [
          {
            "id": "choice_take_salve",
            "text": "\"Thank you, my lord. We will make short work of them.\"",
            "giveItem": { "name": "Healing Potion", "amount": 1 },
            "onEnd": "stay_silent"
          }
        ]
      },
      "node_patron_blessing": {
        "text": "May the radiant dawn shield your spirit, holy one! Take this vial of consecrated Holy Water from our remaining altar reserve. May it burn through their unholy sentinels.",
        "choices": [
          {
            "id": "choice_take_holy_water",
            "text": "\"The dawn will prevail over the shadows.\"",
            "giveItem": { "name": "Holy Water", "amount": 1 },
            "moral_tax": "holy_duty",
            "onEnd": "stay_silent"
          }
        ]
      },
      "node_patron_supplies": {
        "text": "Fair enough. An empty stomach makes for a poor sword-arm. Here are travel rations and a purse of 25 Gold to spend at the Outfitter stall.",
        "choices": [
          {
            "id": "choice_take_rations_gold",
            "text": "\"Much appreciated, Lord Albright.\"",
            "giveItem": { "name": "Rations", "amount": 2 },
            "giveGold": 25,
            "onEnd": "stay_silent"
          }
        ]
      },
      "node_patron_relic_returned": {
        "text": "By all the heavenly powers! The Sun-Forged Relic of Dawn radiates once more in your hands! You have braved the wilderness and shattered the goblin scourge! Oakhaven is saved!",
        "choices": [
          {
            "id": "choice_turn_in_relic",
            "text": "\"Here is your relic, Lord Albright. The goblin warlord will trouble you no more.\"",
            "requiresItem": "Sun-Forged Relic of Dawn",
            "takeItem": "Sun-Forged Relic of Dawn",
            "giveGold": 250,
            "questXP": 3500,
            "playSFX": "victory",
            "onSuccess": "node_patron_epilogue"
          }
        ]
      },
      "node_patron_epilogue": {
        "text": "The entire village cheers! Bells ring out across Oakhaven as the relic is placed upon the golden altar. As promised, here is your 250 Gold bounty and the highest honors of the realm. You are true champions of the realm!",
        "choices": [
          {
            "id": "choice_celebrate",
            "text": "\"Long live Oakhaven! (Expedition Victorious)\"",
            "onEnd": "repeat_terminal"
          }
        ]
      }
    },
    "chieftain_graktar": {
      "node_graktar_parley": {
        "text": "Hahaha! Soft-skinned village dogs dare enter Grak'tar's court? The shiny sun-trinket is ours now! It burns bright in our chest, and soon Grak'tar will burn your little village to cinder! What do you have to say before my boys feed on your marrow?",
        "choices": [
          {
            "id": "choice_fighter_challenge",
            "text": "[Fighter] \"Yield the relic, Grak'tar, or your head rolls upon this stone floor!\"",
            "specialtyClass": "Fighter",
            "specialtyBonus": 3,
            "attribute": "strength",
            "dc": 12,
            "onSuccess": "node_graktar_intimidated",
            "onFail": "node_graktar_combat"
          },
          {
            "id": "choice_cleric_condemn",
            "text": "[Cleric] \"The holy relic burns with sacred fire. Blasphemers cannot hold the light!\"",
            "specialtyClass": "Cleric",
            "specialtyBonus": 3,
            "attribute": "wisdom",
            "dc": 11,
            "onSuccess": "node_graktar_scared_by_faith",
            "onFail": "node_graktar_combat"
          },
          {
            "id": "choice_mage_bluff",
            "text": "[Mage] \"I have woven an arcane detonation into the relic. Touch it again and you turn to ash!\"",
            "specialtyClass": "Mage",
            "specialtyBonus": 2,
            "attribute": "intelligence",
            "dc": 12,
            "onSuccess": "node_graktar_tricked",
            "onFail": "node_graktar_combat"
          },
          {
            "id": "choice_thief_gold_trade",
            "text": "[Thief] \"Keep your lives and take 100 gold pieces for the relic instead.\"",
            "cost": { "gold": 100 },
            "onSuccess": "node_graktar_bribed",
            "onFail": "node_graktar_combat"
          },
          {
            "id": "choice_direct_attack",
            "text": "\"Die, goblin filth! (Draw weapons!)\"",
            "onSuccess": "node_graktar_combat"
          }
        ]
      },
      "node_graktar_intimidated": {
        "text": "Grak'tar eyes your bloody steel and wavers... 'Y-you fight like demons! Take the burning relic from the west chest and go! Grak'tar will find other loot!' The warlord signals his bodyguards to step back.",
        "choices": [
          {
            "id": "choice_take_relic_free",
            "text": "\"A wise decision. Open the chest.\"",
            "giveItem": "Sun-Forged Relic of Dawn",
            "questXP": 800,
            "onEnd": "despawn"
          }
        ]
      },
      "node_graktar_scared_by_faith": {
        "text": "The cleric's holy symbol flashes with blinding solar rays! The goblins screech and clutch their blistered eyes! 'The light burns! Take the curse away!' Grak'tar drops the relic chest key and scrambles into the shadows!",
        "choices": [
          {
            "id": "choice_claim_blessed_relic",
            "text": "\"The light has triumphed.\"",
            "giveItem": "Sun-Forged Relic of Dawn",
            "questXP": 800,
            "onEnd": "despawn"
          }
        ]
      },
      "node_graktar_tricked": {
        "text": "Grak'tar gasps in panic! 'Magic bomb?! Cursed wizards!' The goblins flee into the dungeon corridors, leaving the reliquary chest wide open!",
        "choices": [
          {
            "id": "choice_take_tricked_relic",
            "text": "\"Never duel wits with a wizard.\"",
            "giveItem": "Sun-Forged Relic of Dawn",
            "questXP": 800,
            "onEnd": "despawn"
          }
        ]
      },
      "node_graktar_bribed": {
        "text": "Grak'tar grabs the bag of shining gold coins and bites one with a jagged grin. 'Grak'tar loves gold more than hot sun-stones! Deal! The relic is yours, soft-skins!'",
        "choices": [
          {
            "id": "choice_take_bribed_relic",
            "text": "\"Take your gold and begone.\"",
            "giveItem": "Sun-Forged Relic of Dawn",
            "questXP": 600,
            "onEnd": "despawn"
          }
        ]
      },
      "node_graktar_combat": {
        "text": "Grak'tar roars and brandishes his notched cleaver! 'Kill them all! Strip their armor! Feed them to the pit!'",
        "choices": [
          {
            "id": "choice_fight_graktar",
            "text": "[To Arms!] Engage Grak'tar and his goblin warband!",
            "onEnd": "despawn"
          }
        ]
      }
    }
  }
}
